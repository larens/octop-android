<?xml version="1.0" encoding="utf-8"?>
<!--
  Octop 品牌底色：取自官方图标上的红色对角渐变（#FF0307 → #FF5E60），满幅铺满 108dp。
  自适应图标本身会被系统遮罩裁成圆形/圆角矩形，所以这里不做圆角，避免出现「方块套方块」。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="100.80"
                android:startY="97.53"
                android:endX="5.89"
                android:endY="9.16">
                <item android:offset="0" android:color="#FF0307" />
                <item android:offset="1" android:color="#FF5E60" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
